# Evilginx 3 — Production Environment Configuration
# Copy this file to .env and fill in your values
# ⚠️  NEVER commit .env to version control!

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: Evilginx Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Base domain for all phishing subdomains (e.g., evilcorp.com)
# All phishlet hostnames will be subdomains of this (e.g., github.evilcorp.com)
EVILGINX_DOMAIN=yourdomain.com

# External IPv4 address of this server (your VPS public IP)
# Used for Let's Encrypt certificate validation and DNS resolution
EVILGINX_EXTERNAL_IPV4=1.2.3.4

# Comma-separated list of phishlets to enable on startup
# Available: amazon, citrix, facebook, github, instagram, linkedin, o365, okta, onelogin, outlook, protonmail, reddit, twitter, twitter-mobile, wordpress.org, gmail
EVILGINX_ENABLE_PHISHLETS=github,linkedin,facebook

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Evilginx Advanced Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Bind IP for Evilginx listener (default: 0.0.0.0)
EVILGINX_BIND_IPV4=0.0.0.0

# DNS port (default: 53) - requires NET_BIND_SERVICE capability or root for <1024
EVILGINX_DNS_PORT=53

# HTTPS port (default: 443) - requires NET_BIND_SERVICE capability or root for <1024
EVILGINX_HTTPS_PORT=443

# HTTP port (default: 80) - requires NET_BIND_SERVICE capability or root for <1024
EVILGINX_HTTP_PORT=80

# URL to redirect unauthorized/scanner requests
EVILGINX_UNAUTH_URL=https://www.youtube.com/watch?v=dQw4w9WgXcQ

# Enable developer mode (generates self-signed certs for all hostnames)
# Use ONLY for testing without real domain/IP. Set to "false" for production.
EVILGINX_DEVELOPER=false

# Enable debug output
EVILGINX_DEBUG=false